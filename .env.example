# Server-only contact email settings. Never prefix these with NEXT_PUBLIC_.
# Create .env.local locally, or use your hosting provider's secret settings.
RESEND_API_KEY=
# A bare email address on a domain verified in your Resend account.
# Local-only alternative: onboarding@resend.dev (Resend account inbox only).
# The application refuses that test sender on public/non-loopback origins.
CONTACT_FROM_EMAIL=
# Change this later to route all new form messages to a different inbox.
CONTACT_TO_EMAIL=blessyarthur@gmail.com
# Optional locally; required for a fixed public origin behind a proxy.
# Example: https://your-confirmed-hotel-domain.example
CONTACT_SITE_ORIGIN=
# Enable only if your trusted reverse proxy replaces x-forwarded-for.
CONTACT_TRUST_PROXY=false
